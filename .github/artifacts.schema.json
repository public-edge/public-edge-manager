{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://public-edge.github.io/schemas/artifacts-v1.json",
  "title": "Public Edge release artifact inventory",
  "type": "object",
  "required": ["schemaVersion", "project", "release", "artifacts", "security"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "public-edge.dev/artifacts/v1"},
    "project": {
      "type": "object",
      "required": ["name", "repository", "license"]
    },
    "release": {
      "type": "object",
      "required": ["provider", "page", "tagPattern", "versionSources", "workflow"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "reference", "source", "signed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["oci-image", "helm-oci-chart", "github-release-assets"]
          },
          "reference": {"type": "string", "pattern": "\\{version\\}"},
          "source": {"type": "string", "minLength": 1},
          "signed": {"type": "string", "minLength": 1}
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["policy", "privateReporting", "automation"]
    }
  },
  "additionalProperties": false
}
