{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "runtime": {
      "type": "object",
      "required": ["configMapName"],
      "properties": {
        "configMapName": {"type": "string", "minLength": 1}
      }
    },
    "api": {
      "type": "object",
      "required": ["group"],
      "properties": {
        "group": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$" }
      }
    },
    "nameservers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "services": { "type": "object" },
    "readinessGates": { "type": "object" },
    "bundlePublisher": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nodeName": { "type": "string" },
        "bindAddress": { "type": "string" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "hmacSecretName": { "type": "string" }
      }
    },
    "discovery": {
      "type": "object",
      "required": ["enabled", "replicas", "intervalSeconds", "probeTimeoutSeconds", "gatewaySelector", "authorityLabel", "ingressLabel"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 2},
        "intervalSeconds": {"type": "integer", "minimum": 5},
        "probeTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "defaultCapacityMbps": {"type": "integer", "minimum": 1},
        "minimumCapacityMbps": {"type": "integer", "minimum": 1},
        "clusterInventoryConfigMap": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [{"maxProperties": 0}, {"required": ["namespace", "name", "key"]}],
          "properties": {
            "namespace": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "maxNameservers": {"type": "integer", "minimum": 1, "maximum": 5},
        "dnsPolicy": {"type": "string", "enum": ["ClusterFirst", "Default", "None"]},
        "dnsNameservers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "ipv4"}},
        "excludedNodeNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excludedAuthorityNodeNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "gatewayNamespace": {"type": "string"},
        "gatewaySelector": {"type": "string", "minLength": 3},
        "authorityLabel": {"type": "string", "minLength": 3},
        "ingressLabel": {"type": "string", "minLength": 3},
        "serviceClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "parentZone": {"type": "string"},
        "childZones": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "addressZones": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "requiredAddressNames": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "secondaryNameserversByZone": {
          "type": "object",
          "additionalProperties": {"type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 2}}
        },
        "externalAuthorities": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "address", "nameserver", "region", "enabled"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
              "address": {"type": "string", "minLength": 7},
              "nameserver": {"type": "string", "pattern": "\\.$"},
              "region": {"type": "string", "minLength": 1},
              "capacityMbps": {"type": "integer", "minimum": 1},
              "enabled": {"type": "boolean"}
            }
          }
        },
        "cloudflareSecretRef": {
          "type": "object",
          "properties": {
            "namespace": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "hostNetwork": { "type": "boolean" },
        "maxUnavailable": { "type": "integer", "minimum": 1 },
        "kubernetesApiFallbackUrls": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://[^/]+:[0-9]+$"}},
        "dnsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "containerSecurityContext": { "type": "object" }
      }
    },
    "dns": {
      "type": "object",
      "required": ["soaRname"],
      "properties": {
        "soaRname": { "type": "string", "pattern": "\\.$" },
        "nameserversConfigMap": { "type": "string" },
        "axfrZones": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}},
        "axfrAllowedCidrs": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}},
        "transfer": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "xot", "secondaries"],
          "properties": {
            "role": {"enum": ["disabled", "primary", "secondary"]},
            "xot": {
              "type": "object", "additionalProperties": false,
              "required": ["listenAddress", "serverName", "tlsSecretRef"],
              "properties": {
                "listenAddress": {"type": "string", "pattern": "^.+:[0-9]+$"},
                "serverName": {"type": "string"},
                "tlsSecretRef": {"type": "string"}
              }
            },
            "secondaries": {"type": "array", "uniqueItems": true,
              "items": {"type": "object", "additionalProperties": false, "required": ["id"],
                "properties": {"id": {"type": "string", "minLength": 1}, "dnsName": {"type": "string"}}}}
          }
        },
        "zones": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "pattern": "\\.$" }
        },
        "externalRecords": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "value", "externalCDN"],
              "properties": {
                "type": {"enum": ["A", "AAAA", "CNAME", "TXT"]},
                "value": {"type": "string", "minLength": 1},
                "externalCDN": {"const": true},
                "provider": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "connectTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "responseTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 128 },
        "userAgent": { "type": "string", "minLength": 1 }
      }
    },
    "globalping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiUrl", "apiTokenSecretRef", "intervalSeconds", "locations", "maxTargetsPerKind", "maxMeasurementsPerCycle", "outputConfigMap", "dnsTargets", "httpTargets", "extraAuthorityAddresses", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "apiUrl": {"type": "string", "pattern": "^https://"},
        "apiTokenSecretRef": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        },
        "intervalSeconds": {"type": "integer", "minimum": 300},
        "locations": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {"type": "object", "minProperties": 1}
        },
        "maxTargetsPerKind": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxMeasurementsPerCycle": {"type": "integer", "minimum": 1, "maximum": 32},
        "outputConfigMap": {"type": "string", "minLength": 1},
        "dnsTargets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "httpTargets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "extraAuthorityAddresses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "ipv4"}},
        "resources": {"type": "object"}
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "adapters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "refs"],
            "properties": {
              "enabled": { "type": "boolean" },
              "provider": { "type": "string", "minLength": 1 },
              "refs": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["namespace", "name"],
                  "properties": {
                    "namespace": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "refs": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": { "mutateIngresses": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] }
      }
    },
    "candidateSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacityWeight", "localAreaBonus", "priorityWeight", "latencyDivisorMs", "latencyPenaltyCap", "localNodeBonus", "failoverGraceSeconds", "minReadySeconds", "minHoldSeconds", "resolverCidrs"],
      "properties": {
        "capacityWeight": {"type": "integer", "minimum": 0},
        "localAreaBonus": {"type": "integer", "minimum": 0},
        "priorityWeight": {"type": "integer", "minimum": 0},
        "latencyDivisorMs": {"type": "integer", "minimum": 1},
        "latencyPenaltyCap": {"type": "integer", "minimum": 0},
        "localNodeBonus": {"type": "integer", "minimum": 0},
        "failoverGraceSeconds": {"type": "integer", "minimum": 0},
        "minReadySeconds": {"type": "integer", "minimum": 0},
        "minHoldSeconds": {"type": "integer", "minimum": 0},
        "resolverCidrs": {"type": "object"}
      }
    }
    ,"routingPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["regions", "defaultRegion", "trustedEcsPrefixes"],
      "properties": {
        "regions": {"type": "object", "additionalProperties": {"type": "array"}},
        "defaultRegion": {"type": "string", "minLength": 1},
        "trustedEcsPrefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
    ,"routeSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "publicKeyRef", "signingKeySecretRef", "tlsSecretRef", "statePath", "refreshSeconds", "maxStaleSeconds"],
      "properties": {
        "endpoint": {"type": "string"}, "publicKeyRef": {"type": "string"},
        "signingKeySecretRef": {"type": "string"}, "tlsSecretRef": {"type": "string"},
        "statePath": {"type": "string", "minLength": 1},
        "refreshSeconds": {"type": "integer", "minimum": 5},
        "maxStaleSeconds": {"type": "integer", "minimum": 0}
      }
    }
    ,"transferTopology": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "secondaries", "shadowDnsPort", "httpPort"],
      "properties": {
        "shadowDnsPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "httpPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "primary": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "nodeName", "tlsSecretRef", "snapshotTlsSecretRef", "signingKeySecretRef"],
          "properties": {
            "enabled": {"type": "boolean"}, "nodeName": {"type": "string"},
            "tlsSecretRef": {"type": "string"}, "snapshotTlsSecretRef": {"type": "string"},
            "signingKeySecretRef": {"type": "string"}
          }
        },
        "secondaries": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "enabled", "nodeName", "tlsSecretRef"],
          "properties": {"id": {"type": "string"}, "enabled": {"type": "boolean"},
            "nodeName": {"type": "string"}, "tlsSecretRef": {"type": "string"}}
        }}
      }
    }
    ,"fabricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "apiGroup", "apiVersion", "resource", "requireNodeReady", "allowedStates"],
      "properties": {
        "mode": { "enum": ["Disabled", "Shadow", "Optional", "Required"] },
        "apiGroup": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$" },
        "apiVersion": { "type": "string", "pattern": "^v[0-9]+((alpha|beta)[0-9]+)?$" },
        "resource": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "requireNodeReady": { "type": "boolean" },
        "requireDNSDependencies": { "type": "boolean" },
        "allowedStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Ready", "Partial"] } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "services": { "minProperties": 1 }
        }
      }
    },
    {
      "if": {"properties": {"globalping": {"properties": {"enabled": {"const": true}}}}},
      "then": {"properties": {"globalping": {"properties": {"apiTokenSecretRef": {"properties": {"name": {"minLength": 1}}}}}}}
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "refs": { "type": "object" },
              "adapters": { "type": "object" }
            }
          },
          "rbac": {
            "properties": { "mutateIngresses": { "const": true } }
          }
        },
        "anyOf": [
          { "properties": { "publication": { "properties": { "adapters": { "minProperties": 1 } } } } },
          { "properties": { "publication": { "properties": { "refs": { "minProperties": 1 } } } } }
        ]
      }
    }
  ]
}
